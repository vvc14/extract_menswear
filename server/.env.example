NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/extract-menswear
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Razorpay (Dashboard → Settings → Webhooks). Webhook URL: https://<your-api>/api/payment/razorpay/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Storefront origin (CORS). Extra origins, comma-separated, go in CORS_ORIGINS.
CLIENT_URL=https://your-store.example.com
CORS_ORIGINS=
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY_HOPS=1

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Email ───
# Deliverability: send from an address on YOUR domain (e.g. orders@yourstore.com) through a
# transactional provider, with SPF, DKIM and DMARC DNS records set up (see AUDIT_REPORT.md).
# Check the result with: npm run email:test -- <address from mail-tester.com>
EMAIL_FROM=orders@your-store.example.com
EMAIL_FROM_NAME=Extract Menswear
EMAIL_REPLY_TO=support@your-store.example.com

# Option A (recommended on hosts that block SMTP, e.g. free tiers): Brevo HTTPS API
BREVO_API_KEY=
# Option B: any SMTP relay (Brevo SMTP: smtp-relay.brevo.com:587, Amazon SES, Zoho, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option C (testing only): Gmail account + app password. EMAIL_FROM must be this same address.
EMAIL_USER=
EMAIL_PASS=
# Where return/exchange requests and contact messages are sent (defaults to EMAIL_REPLY_TO, then EMAIL_FROM)
ADMIN_NOTIFY_EMAIL=

# Only used by `node seed.js` to create an admin account
ADMIN_USERNAME=
ADMIN_PASSWORD=
