# Local development: leave VITE_API_URL empty to use the Vite proxy (/api → http://localhost:5000).
# Production (Vercel): the full API URL, e.g. https://api.yourstore.com/api
VITE_API_URL=
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# URL segment for the admin panel. Choose your own; the admin API is protected server-side regardless.
VITE_ADMIN_PATH=choose-a-private-admin-path
